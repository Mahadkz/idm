// Download dialogs laid out from IDM dialog templates 4 ("Download File Info"),
// 2 ("Download progress"), 91 ("Speed Limiter") and 56 ("Download complete").
// Dialog units convert to pixels as x * 1.5 and y * 1.625 (Tahoma 8).
// All artwork here is original: plain rectangles and paths drawn for XDM.
import { ListView } from "std-widgets.slint";
import "../../assets/fonts/tahoma.ttf";
import "../../assets/fonts/tahomabd.ttf";

export struct SegView { from: float, done: float, to: float }
export struct ConnRow { n: string, downloaded: string, info: string }

component IdmButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();
    background: !root.enabled ? #f0f0f0 : ta.pressed ? #cce4f7 : ta.has-hover ? #e5f1fb : #ffffff;
    border-width: 1px;
    border-color: !root.enabled ? #cfcfcf : (root.primary || ta.has-hover) ? #0078d7 : #8c8c8c;
    accessible-role: button;
    accessible-label: root.text;
    Text {
        text: root.text;
        color: root.enabled ? #000000 : #838383;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}



component IdmEdit inherits Rectangle {
    in-out property <string> text;
    in property <bool> read-only;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    background: root.read-only || !root.enabled ? #f0f0f0 : #ffffff;
    border-width: 1px;
    border-color: input.has-focus ? #0078d7 : #7a7a7a;
    clip: true;
    input := TextInput {
        x: 4px; width: root.width - 8px; height: root.height;
        text <=> root.text;
        font-size: 11px;
        color: #000000;
        vertical-alignment: center;
        read-only: root.read-only;
        enabled: root.enabled;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
}

component IdmCheck inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();
    width: 330px;
    height: 16px;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    Rectangle {
        x: 0px; y: 1px; width: 13px; height: 13px;
        background: #ffffff; border-width: 1px; border-color: ta.has-hover ? #0078d7 : #8e8f8f;
        if root.checked: Path {
            x: 2px; y: 2px; width: 9px; height: 9px;
            commands: "M 0 4 L 3 8 L 9 0";
            stroke: #1f1f1f; stroke-width: 1.6px; fill: transparent;
        }
    }
    Text {
        x: 19px; text: root.text; font-size: 11px; color: #000000;
        vertical-alignment: center; overflow: elide; width: root.width - 19px;
    }
    ta := TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

component IdmCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected(string);
    background: #ffffff;
    border-width: 1px;
    border-color: ta.has-hover ? #0078d7 : #7a7a7a;
    Text {
        x: 4px; width: root.width - 24px;
        text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
        font-size: 11px; color: #000000; vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: root.width - 18px; y: 1px; width: 17px; height: root.height - 2px; background: #e1e1e1;
        Path {
            x: 4px; y: parent.height / 2 - 2px; width: 9px; height: 5px;
            commands: "M 0 0 L 4.5 4.5 L 9 0";
            stroke: #1f1f1f; stroke-width: 1.2px; fill: transparent;
        }
    }
    ta := TouchArea { clicked => { list.show(); } }
    list := PopupWindow {
        x: 0px; y: root.height; width: root.width;
        height: root.model.length * 18px + 2px;
        Rectangle { background: #ffffff; border-width: 1px; border-color: #7a7a7a; }
        VerticalLayout {
            padding: 1px;
            for item[i] in root.model: Rectangle {
                height: 18px;
                background: it.has-hover ? #cce8ff : #ffffff;
                Text { x: 4px; width: parent.width - 8px; text: item; font-size: 11px; color: #000000; vertical-alignment: center; }
                it := TouchArea { clicked => { root.current-index = i; root.selected(item); } }
            }
        }
    }
}

component Label inherits Text {
    color: #000000;
    font-size: 11px;
    vertical-alignment: center;
    overflow: elide;
}

// Original document glyph: a page with a folded corner.
component FileGlyph inherits Rectangle {
    in property <string> kind;
    background: #ffffff;
    border-width: 1px;
    border-color: #6f6f6f;
    Rectangle {
        x: parent.width - 8px;
        y: 0px;
        width: 8px;
        height: 8px;
        background: #d9d9d9;
        border-width: 1px;
        border-color: #6f6f6f;
    }
    for i in 4: Rectangle {
        x: 4px;
        y: 12px + i * 4px;
        width: parent.width - 8px;
        height: 1px;
        background: #9a9a9a;
    }
}

export component FileInfoWindow inherits Window {
    title: "Download File Info";
    width: 570px;
    height: 208px;
    background: #f5f5f5;
    default-font-family: "Tahoma";
    in-out property <string> url;
    in property <[string]> categories;
    in-out property <int> category-index;
    in-out property <string> save-as;
    in property <[string]> history;
    in-out property <bool> remember: true;
    in property <string> remember-label;
    in property <string> remember-path;
    in-out property <string> description;
    in property <string> size-text: "unknown";
    in property <string> message;
    in property <bool> busy;
    in property <bool> dup-visible;
    in property <string> dup-text;
    callback start();
    callback later();
    callback cancel();
    callback browse();
    callback new-category();
    callback category-picked(string);
    callback save-as-edited(string);
    callback url-accepted(string);
    callback dup-copy();
    callback dup-open();
    callback dup-cancel();
    

    Label { x: 7px; y: 5px; width: 77px; height: 16px; text: "URL"; horizontal-alignment: right; }
    url-edit := IdmEdit {
        x: 96px; y: 5px; width: 366px; height: 23px;
        text <=> root.url;
        accepted(value) => { root.url-accepted(value); }
    }
    Label { x: 7px; y: 38px; width: 77px; height: 16px; text: "Category"; horizontal-alignment: right; }
    IdmCombo {
        x: 96px; y: 34px; width: 174px; height: 23px;
        model: root.categories;
        current-index <=> root.category-index;
        selected(value) => { root.category-picked(value); }
    }
    IdmButton { x: 274px; y: 34px; width: 24px; height: 23px; text: "+"; clicked => { root.new-category(); } }
    Label { x: 7px; y: 67px; width: 77px; height: 16px; text: "Save As"; horizontal-alignment: right; }
    save-edit := IdmEdit {
        x: 96px; y: 63px; width: 334px; height: 23px;
        text <=> root.save-as;
        edited(value) => { root.save-as-edited(value); }
    }
    Rectangle {
        x: 412px; y: 64px; width: 17px; height: 21px; background: #f0f0f0;
        opacity: root.history.length > 0 ? 1 : 0.4;
        Path {
            x: 4px; y: 8px; width: 9px; height: 5px;
            commands: "M 0 0 L 4.5 4.5 L 9 0";
            stroke: #1f1f1f; stroke-width: 1.2px; fill: transparent;
        }
        TouchArea { enabled: root.history.length > 0; clicked => { history-popup.show(); } }
    }
    IdmButton { x: 438px; y: 63px; width: 24px; height: 23px; text: "..."; clicked => { root.browse(); } }
    history-popup := PopupWindow {
        x: 96px; y: 86px; width: 334px;
        height: min(root.history.length, 8) * 20px + 2px;
        Rectangle { background: #ffffff; border-width: 1px; border-color: #7a7a7a; }
        VerticalLayout {
            padding: 1px;
            for item in root.history: Rectangle {
                height: 20px;
                background: item-ta.has-hover ? #cce8ff : #ffffff;
                Label { x: 4px; width: parent.width - 8px; text: item; }
                item-ta := TouchArea {
                    clicked => { root.save-as = item; root.save-as-edited(item); }
                }
            }
        }
    }
    // Group box with the "remember this path" check box in its caption.
    Rectangle {
        x: 96px; y: 98px; width: 366px; height: 45px;
        border-width: 1px; border-color: #d5d5d5; border-radius: 2px;
    }
    Rectangle { x: 100px; y: 90px; width: 330px; height: 16px; background: #f5f5f5; }
    IdmCheck {
        x: 100px; y: 89px; height: 18px;
        text: root.remember-label;
        checked <=> root.remember;
    }
    IdmEdit {
        x: 103px; y: 112px; width: 348px; height: 23px;
        read-only: true;
        text: root.remember-path;
    }
    Label { x: 7px; y: 152px; width: 77px; height: 16px; text: "Description"; horizontal-alignment: right; }
    IdmEdit {
        x: 96px; y: 148px; width: 366px; height: 23px;
        text <=> root.description;
    }
    IdmButton {
        x: 96px; y: 179px; width: 111px; height: 23px; text: "Download Later";
        enabled: !root.busy;
        clicked => { root.later(); }
    }
    IdmButton {
        x: 223px; y: 179px; width: 111px; height: 23px; text: "Start Download";
        primary: true;
        enabled: !root.busy;
        clicked => { root.start(); }
    }
    IdmButton { x: 351px; y: 179px; width: 111px; height: 23px; text: "Cancel"; clicked => { root.cancel(); } }
    FileGlyph { x: 500px; y: 45px; width: 30px; height: 36px; }
    Label { x: 466px; y: 93px; width: 96px; height: 16px; text: root.size-text; horizontal-alignment: center; }
    // Daemon refusals appear in the empty column right of the fields.
    Text {
        x: 468px; y: 120px; width: 96px; height: 80px;
        text: root.message;
        color: #b00020;
        font-size: 10px;
        wrap: word-wrap;
        overflow: elide;
    }
    if root.dup-visible: Rectangle {
        background: #00000040;
        TouchArea { }
        Rectangle {
            x: 40px; y: 40px; width: parent.width - 80px; height: 140px;
            background: #f5f5f5; border-width: 1px; border-color: #7a7a7a;
            Text {
                x: 14px; y: 12px; width: parent.width - 28px; height: 70px;
                text: root.dup-text; wrap: word-wrap; font-size: 11px; color: #000000;
            }
            IdmButton { x: 14px; y: 98px; width: 150px; height: 24px; text: "Add numbered copy"; clicked => { root.dup-copy(); } }
            IdmButton { x: 174px; y: 98px; width: 130px; height: 24px; text: "Open existing"; clicked => { root.dup-open(); } }
            IdmButton { x: 314px; y: 98px; width: 100px; height: 24px; text: "Cancel"; clicked => { root.dup-cancel(); } }
        }
    }
}

component TabHead inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    background: root.selected ? #f5f5f5 : #e8e8e8;
    border-width: 1px;
    border-color: #c4c4c4;
    Label { text: root.text; horizontal-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

export component ProgressWindow inherits Window {
    title: root.title-text;
    width: 535px;
    height: root.details-visible ? 408px : 245px;
    background: #f5f5f5;
    default-font-family: "Tahoma";
    in property <string> title-text;
    in property <string> url-text;
    in property <string> status-text;
    in property <bool> status-error;
    in property <string> file-size-text;
    in property <string> downloaded-text;
    in property <string> rate-text;
    in property <string> time-left-text;
    in property <string> resume-text;
    in property <float> percent;
    in property <string> pause-text: "Pause";
    in property <bool> pause-enabled: true;
    in-out property <bool> details-visible: true;
    in-out property <int> tab;
    in property <[SegView]> segments;
    in property <[ConnRow]> connections;
    in property <string> limiter-rate-text;
    in-out property <bool> use-limit;
    in-out property <string> limit-kb;
    in-out property <bool> opt-open-file;
    in-out property <bool> opt-open-folder;
    in-out property <bool> opt-show-complete: true;
    callback pause-resume();
    callback cancel();
    callback details-toggled();
    callback limit-apply();

    // Tab strip and panel (resource 2: static 1760 at 7,5 size 338x101).
    TabHead { x: 10px; y: 8px; width: 130px; height: 22px; text: "Download status"; selected: root.tab == 0; clicked => { root.tab = 0; } }
    TabHead { x: 140px; y: 8px; width: 110px; height: 22px; text: "Speed Limiter"; selected: root.tab == 1; clicked => { root.tab = 1; } }
    TabHead { x: 250px; y: 8px; width: 160px; height: 22px; text: "Options on completion"; selected: root.tab == 2; clicked => { root.tab = 2; } }
    Rectangle { x: 10px; y: 29px; width: 512px; height: 143px; border-width: 1px; border-color: #c4c4c4; }

    if root.tab == 0: Rectangle {
        x: 0px; y: 0px;
        Label { x: 14px; y: 34px; width: 495px; height: 16px; text: root.url-text; color: #1a3f9a; }
        Label { x: 94px; y: 54px; width: 410px; height: 16px; text: root.status-text; color: root.status-error ? #b00020 : #0000ee; }
        Label { x: 14px; y: 73px; width: 108px; height: 16px; text: "File size"; }
        Label { x: 127px; y: 73px; width: 300px; height: 16px; text: root.file-size-text; }
        Label { x: 14px; y: 90px; width: 108px; height: 16px; text: "Downloaded"; }
        Label { x: 127px; y: 90px; width: 300px; height: 16px; text: root.downloaded-text; }
        Label { x: 14px; y: 106px; width: 108px; height: 16px; text: "Transfer rate"; }
        Label { x: 127px; y: 106px; width: 300px; height: 16px; text: root.rate-text; }
        Label { x: 14px; y: 122px; width: 108px; height: 16px; text: "Time left"; }
        Label { x: 127px; y: 122px; width: 300px; height: 16px; text: root.time-left-text; }
        Label { x: 14px; y: 140px; width: 120px; height: 16px; text: "Resume capability"; }
        Label { x: 203px; y: 140px; width: 120px; height: 16px; text: root.resume-text; }
    }
    if root.tab == 1: Rectangle {
        x: 0px; y: 0px;
        // Resource 91 controls, shifted by the tab strip.
        Label { x: 16px; y: 40px; width: 94px; height: 16px; text: "Transfer rate"; }
        Label { x: 120px; y: 40px; width: 300px; height: 16px; text: root.limiter-rate-text; }
        IdmCheck { x: 16px; y: 62px; height: 18px; text: "Use Speed Limiter"; checked <=> root.use-limit; toggled => { root.limit-apply(); } }
        Label { x: 16px; y: 88px; width: 260px; height: 16px; text: "Maximum download speed:"; }
        IdmEdit {
            x: 16px; y: 108px; width: 77px; height: 23px;
            enabled: root.use-limit;
            text <=> root.limit-kb;
            accepted(value) => { root.limit-apply(); }
        }
        Label { x: 100px; y: 112px; width: 100px; height: 16px; text: "KBytes/sec"; }
    }
    if root.tab == 2: Rectangle {
        x: 0px; y: 0px;
        IdmCheck { x: 16px; y: 44px; height: 18px; text: "Show the Download complete dialog"; checked <=> root.opt-show-complete; }
        IdmCheck { x: 16px; y: 70px; height: 18px; text: "Open the file when the download completes"; checked <=> root.opt-open-file; }
        IdmCheck { x: 16px; y: 96px; height: 18px; text: "Open the folder when the download completes"; checked <=> root.opt-open-folder; }
        Label {
            x: 16px; y: 126px; width: 485px; height: 40px;
            text: "Sleep, shutdown and restart are set per queue in Queue settings.";
            wrap: word-wrap; color: #555555;
        }
    }

    // Progress bar (static 1146 at 7,111 size 338x10).
    Rectangle {
        x: 10px; y: 180px; width: 512px; height: 16px;
        background: #ffffff; border-width: 1px; border-color: #7a7a7a;
        Rectangle {
            x: 1px; y: 1px;
            width: (parent.width - 2px) * max(0, min(1, root.percent));
            height: parent.height - 2px;
            background: #3c9a3c;
        }
    }
    IdmButton {
        x: 22px; y: 206px; width: 140px; height: 24px;
        text: root.details-visible ? "<< Hide details" : "Show details >>";
        clicked => { root.details-visible = !root.details-visible; root.details-toggled(); }
    }
    IdmButton { x: 309px; y: 206px; width: 84px; height: 24px; text: root.pause-text; enabled: root.pause-enabled; clicked => { root.pause-resume(); } }
    IdmButton { x: 420px; y: 206px; width: 75px; height: 24px; text: "Cancel"; clicked => { root.cancel(); } }

    if root.details-visible: Rectangle {
        x: 0px; y: 0px;
        Label { x: 31px; y: 232px; width: 473px; height: 16px; text: "Start positions and download progress by connections"; horizontal-alignment: center; }
        // Segment bar (static 1179 at 7,153 size 338x10).
        Rectangle {
            x: 10px; y: 249px; width: 512px; height: 16px;
            background: #dfe6f5; border-width: 1px; border-color: #5a5a7a;
            for seg[i] in root.segments: Rectangle {
                x: 1px + (parent.width - 2px) * seg.from;
                y: 4px;
                width: max(0px, (parent.width - 2px) * (seg.done - seg.from));
                height: parent.height - 8px;
                background: #3f6fd8;
            }
            for seg[i] in root.segments: Rectangle {
                x: 1px + (parent.width - 2px) * seg.from;
                y: 1px;
                width: 1px;
                height: parent.height - 2px;
                background: i == 0 ? #303050 : #d02020;
            }
        }
        // Connections table (list view 1177 at 7,168 size 338x79).
        Rectangle {
            x: 11px; y: 274px; width: 511px; height: 126px;
            background: #ffffff; border-width: 1px; border-color: #7a7a7a;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: 17px; background: #f0f0f0;
                Label { x: 7px; width: 30px; text: "N."; }
                Label { x: 36px; width: 100px; text: "Downloaded"; }
                Label { x: 136px; width: 200px; text: "Info"; }
                Rectangle { x: 30px; width: 1px; background: #d0d0d0; }
                Rectangle { x: 130px; width: 1px; background: #d0d0d0; }
            }
            ListView {
                x: 1px; y: 18px; width: parent.width - 2px; height: parent.height - 19px;
                for row in root.connections: Rectangle {
                    height: 14px;
                    background: #bfb4be;
                    Label { x: 13px; width: 17px; text: row.n; }
                    Label { x: 36px; width: 92px; text: row.downloaded; }
                    Label { x: 136px; width: 300px; text: row.info; }
                }
            }
        }
    }
}

export component CompleteWindow inherits Window {
    title: "Download complete";
    width: 455px;
    height: 215px;
    background: #f5f5f5;
    default-font-family: "Tahoma";
    in property <string> headline: "Download complete";
    in property <string> size-line;
    in property <string> address;
    in property <string> saved-as;
    in-out property <bool> dont-show;
    callback open();
    callback open-with();
    callback open-folder();
    callback dismiss();
    callback dont-show-toggled(bool);

    Rectangle {
        x: 10px; y: 11px; width: 32px; height: 32px;
        background: #ffffff; border-width: 1px; border-color: #6f9f4a; border-radius: 3px;
        Path {
            x: 7px; y: 9px; width: 18px; height: 14px;
            commands: "M 2 8 L 7 13 L 16 2";
            stroke: #3c9a3c; stroke-width: 3px;
            fill: transparent;
        }
    }
    Label { x: 51px; y: 9px; width: 393px; height: 16px; text: root.headline; }
    Label { x: 51px; y: 27px; width: 393px; height: 16px; text: root.size-line; }
    Label { x: 10px; y: 60px; width: 433px; height: 15px; text: "Address"; }
    IdmEdit { x: 10px; y: 78px; width: 433px; height: 23px; read-only: true; text: root.address; }
    Label { x: 10px; y: 105px; width: 433px; height: 15px; text: "The file saved as"; }
    IdmEdit { x: 10px; y: 123px; width: 433px; height: 23px; read-only: true; text: root.saved-as; }
    IdmButton { x: 10px; y: 156px; width: 91px; height: 23px; text: "Open"; primary: true; clicked => { root.open(); } }
    IdmButton { x: 114px; y: 156px; width: 91px; height: 23px; text: "Open with..."; clicked => { root.open-with(); } }
    IdmButton { x: 218px; y: 156px; width: 91px; height: 23px; text: "Open folder"; clicked => { root.open-folder(); } }
    IdmButton { x: 352px; y: 156px; width: 91px; height: 23px; text: "Close"; clicked => { root.dismiss(); } }
    IdmCheck {
        x: 24px; y: 188px; height: 18px;
        text: "Don't show this dialog again";
        checked <=> root.dont-show;
        toggled => { root.dont-show-toggled(root.dont-show); }
    }
}
