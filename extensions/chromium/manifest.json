{
  "manifest_version": 3,
  "name": "XDM Browser Bridge",
  "version": "0.1.0",
  "description": "Send eligible browser downloads and clear media URLs to XDM.",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage", "cookies", "webRequest", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]
}
