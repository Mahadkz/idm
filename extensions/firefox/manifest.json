{
  "manifest_version": 2,
  "name": "XDM Browser Bridge",
  "version": "0.1.0",
  "description": "Send eligible browser downloads and clear media URLs to XDM.",
  "browser_specific_settings": {"gecko": {"id": "xdm@xdm.local", "strict_min_version": "91.0"}},
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "cookies",
    "webRequest",
    "tabs",
    "notifications",
    "management",
    "webNavigation",
    "proxy",
    "http://*/*",
    "https://*/*"
  ],
  "background": {"scripts": ["core.js", "background.js"]},
  "browser_action": {"default_popup": "popup.html"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js", "page_xhr.js", "page_fetch.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": ["page_helper.js"]
}
