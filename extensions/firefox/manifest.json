{
  "manifest_version": 2,
  "name": "XDM Browser Bridge",
  "version": "0.1.0",
  "description": "Send eligible browser downloads and clear media URLs to XDM.",
  "browser_specific_settings": {"gecko": {"id": "xdm@xdm.local", "strict_min_version": "91.0"}},
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage", "cookies", "webRequest", "tabs", "http://*/*", "https://*/*"],
  "background": {"scripts": ["core.js", "background.js"]},
  "browser_action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]
}
